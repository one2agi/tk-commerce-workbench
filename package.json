{
  "name": "tk-commerce-workbench",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tk/web --filter @tk/worker dev",
    "start:local": "node scripts/start-local-production.mjs",
    "build": "pnpm -r build",
    "lint": "eslint apps packages tests e2e --max-warnings=0",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/run-tests.mjs",
    "test:integration": "pnpm --filter @tk/db test:integration && pnpm --filter @tk/worker test:integration",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @tk/db db:generate",
    "db:migrate": "pnpm --filter @tk/db db:migrate",
    "docker:dev:up": "node scripts/docker-local.mjs dev:up",
    "docker:dev:down": "node scripts/docker-local.mjs dev:down",
    "docker:status": "node scripts/docker-local.mjs dev:status",
    "docker:logs": "node scripts/docker-local.mjs dev:logs",
    "docker:backup": "node scripts/docker-local.mjs backup",
    "docker:prod:build": "node scripts/docker-local.mjs prod:build",
    "docker:prod:up": "node scripts/docker-local.mjs prod:up",
    "docker:prod:down": "node scripts/docker-local.mjs prod:down",
    "docker:image:export": "node scripts/docker-local.mjs image:export",
    "docker:image:import": "node scripts/docker-local.mjs image:import",
    "test:docker": "node --test scripts/tests/docker-*.test.mjs scripts/tests/run-next-container.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "jsdom": "29.1.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
