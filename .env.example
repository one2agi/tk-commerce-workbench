# 基础设施配置。服务地址、模型、API Key、妙手授权、S3 和扩展 Token
# 均在 http://127.0.0.1:3000/settings 中维护，不再要求日常编辑 env。

DATABASE_URL=
TEST_DATABASE_URL=
LOCAL_OPERATOR_ID=local-operator

# 唯一必须由部署环境保管的业务主密钥。
# 生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 数据库备份与这个值必须成对保存；丢失后无法解密数据库中的服务凭据。
CONFIG_ENCRYPTION_KEY=

# Docker Compose 会在容器内覆盖数据库地址和 ALLOW_LAN。
ALLOW_LAN=false
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost

# 仍属于部署边界的本地路径与 Worker 租约。
ASSET_ROOT=./data/assets
WORKER_LEASE_MS=60000

# 可选：升级旧版本时保留一次即可。首次启动会把这些值加密导入数据库；
# 确认设置页显示“已配置”且 Worker 已应用后，可以从 env 删除。
EXTENSION_TOKEN=
EXTERNAL_ADAPTER_MODE=mock
WORKER_CONCURRENCY=2
MAX_CANVAS_RUNS_PER_DAY=50
IMAGE_GENERATION_PATH=headless
IMAGE_PLANNER_BASE_URL=
IMAGE_PLANNER_API_KEY=
IMAGE_PLANNER_MODEL=
IMAGE_PROVIDER_BASE_URL=
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_MODEL=
CANVAS_BASE_URL=
CANVAS_ID=
CANVAS_WORKFLOW_NAME=TK工作流
CANVAS_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EXCHANGE_RATE_BASE_URL=
MIAOSHOU_APP_KEY=
MIAOSHOU_APP_SECRET=
MIAOSHOU_AUTHORIZATION=
MIAOSHOU_COOKIE=
MIAOSHOU_BASE_URL=
MIAOSHOU_ACCOUNT_ID=
ASSET_PUBLISH_S3_ENDPOINT=
ASSET_PUBLISH_S3_REGION=
ASSET_PUBLISH_S3_BUCKET=
ASSET_PUBLISH_S3_ACCESS_KEY_ID=
ASSET_PUBLISH_S3_SECRET_ACCESS_KEY=
ASSET_PUBLISH_PUBLIC_BASE_URL=
