# 全部变量只在这里登记名称。
# 真实值必须来自环境或本地加密 secrets 文件，不得进入仓库、日志或测试 fixture。

# 主数据库与测试数据库（集成测试必须能解析 TEST_DATABASE_URL，且数据库名以 _test 结尾）
DATABASE_URL=
TEST_DATABASE_URL=

# 固定本地操作员 ID；启动时必须存在
LOCAL_OPERATOR_ID=

# 浏览器扩展调用本机摄取 API 的 Bearer Token；服务端只保存 SHA-256 摘要
EXTENSION_TOKEN=

# 是否允许监听非 loopback。开发态必须保持 false。
ALLOW_LAN=false

# 外部 Adapter 模式：mock | live；测试/E2E 中 live 必须启动失败
EXTERNAL_ADAPTER_MODE=mock

# 妙手（仅在 live 命令上下文使用）
MIAOSHOU_APP_KEY=
MIAOSHOU_APP_SECRET=

# Canvas（仅 live 使用）
CANVAS_BASE_URL=
CANVAS_API_KEY=

# LLM 翻译 provider（OpenAI-compatible）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 汇率
EXCHANGE_RATE_BASE_URL=

# 本地素材目录（图片永久存储）
ASSET_ROOT=./data/assets

# Worker 并发与租约
WORKER_CONCURRENCY=2
WORKER_LEASE_MS=60000

# Canvas 每日运行上限
MAX_CANVAS_RUNS_PER_DAY=50
